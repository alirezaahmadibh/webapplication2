<% if (error) { %>
  <h1>Error</h1>
  <p><%= error.message %></p>
<% } else { %>
  <h1>Unknown Error</h1>
  <p>An unknown error occurred.</p>
<% } %> <%# This EJS template displays an error message if an error object is passed to the view. If no error object is provided, it shows a generic "Unknown Error" message.%>