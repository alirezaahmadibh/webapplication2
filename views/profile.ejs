<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Profile</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
        <div class="container">

            <a class="navbar-brand" href="#">
                My Application
            </a>

            <div class="ms-auto">

                <a href="/auth/logout" class="btn btn-danger btn-sm">
                    Logout
                </a>

            </div>

        </div>
    </nav>

    <!-- Main Container -->
    <div class="container mt-5">

        <div class="row justify-content-center">

            <div class="col-md-8">

                <div class="card shadow-lg border-0 rounded-4">

                    <!-- Card Header -->
                    <div class="card-header bg-primary text-white text-center rounded-top-4 p-4">

                        <img 
                            src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                            width="100"
                            class="rounded-circle border border-4 border-white mb-3"
                        >

                        <h2>
                            Welcome
                            <%= user.firstName %>
                            <%= user.lastName %>
                        </h2>

                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-5">

                        <div class="row mb-4">

                            <div class="col-md-6">

                                <h5 class="text-muted">
                                    First Name
                                </h5>

                                <p class="fs-5">
                                    <%= user.firstName %>
                                </p>

                            </div>

                            <div class="col-md-6">

                                <h5 class="text-muted">
                                    Last Name
                                </h5>

                                <p class="fs-5">
                                    <%= user.lastName %>
                                </p>

                            </div>

                        </div>

                        <hr>

                        <div class="mb-4">

                            <h5 class="text-muted">
                                Email Address
                            </h5>

                            <p class="fs-5">
                                <%= user.email %>
                            </p>

                        </div>

                        <hr>

                        <div class="d-grid gap-2">

                            <a href="/user/edit-profile" class="btn btn-warning">
                                Edit Profile
                            </a>

                            <a href="/" class="btn btn-secondary">
                                Back To Home
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>